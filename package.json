                            "@vitejs/plugin-react":  "^6.0.3",
                            "autoprefixer":  "^10.5.2",
                            "gh-pages":  "^6.3.0",
                            "lucide-react":  "^1.24.0",
                            "oxlint":  "^1.71.0",
                            "postcss":  "^8.5.16",
